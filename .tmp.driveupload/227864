# Texto normalizado (LF no repo)
* text=auto eol=lf
# Código e arquivos de texto (força LF)
*.py   text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ini  text eol=lf
# Binários e grandes (LFS)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.csv  filter=lfs diff=lfs merge=lfs -text
