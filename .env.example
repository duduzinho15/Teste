# Configurações do Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHANNEL_ID=@seu_canal
TELEGRAM_ADMIN_USER_ID=seu_user_id

# Configurações de Banco de Dados
DATABASE_URL=sqlite:///garimpeiro_geek.db

# Configurações de Logging
LOG_LEVEL=INFO
LOG_FILE=logs/garimpeiro_geek.log

# Configurações de Afiliados
AFFILIATE_AMAZON_TAG=garimpeirogee-20
AFFILIATE_AWIN_PUBLISHER_ID=seu_awin_id
AFFILIATE_RAKUTEN_ID=seu_rakuten_id

# Configurações de Pontuação de Ofertas
DEAL_SCORE_CRITICAL=0.85
DEAL_SCORE_HIGH=0.75
ELECTRONICS_MIN_DISC=0.20
PERIPHERALS_MIN_DISC=0.25
APPLIANCES_MIN_DISC=0.18
TRUSTED_SELLERS=Magazine Luiza,Kabum,Pichau,Americanas,Submarino

# Configurações de Rate Limiting do Telegram
TG_MIN_INTERVAL_CRITICAL=20
TG_MIN_INTERVAL_HIGH=120
TG_MAX_PER_HOUR=20
PEAK_HOURS=07:30-09:30,12:00-14:00,19:00-22:30

# Configurações Rakuten
RAKUTEN_ENABLED=false
RAKUTEN_WEBSERVICE_TOKEN=
RAKUTEN_SECURITY_TOKEN=

# Configurações Shopee
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Configurações AliExpress
ALI_APP_KEY=
ALI_APP_SECRET=
